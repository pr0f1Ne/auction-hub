generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum AuctionStatus {
  PENDING    // Chờ diễn ra
  ACTIVE     // Đang diễn ra
  ENDED      // Đã kết thúc (chờ tạo đơn)
  CANCELLED  // Bị hủy
}

enum OrderStatus {
  PENDING_PAYMENT // Chờ thanh toán
  PAID            // Đã thanh toán (Tiền vào Escrow)
  SHIPPING        // Đang giao hàng
  DELIVERED       // Đã giao (Chờ người mua xác nhận)
  DISPUTE         // Có tranh chấp
  COMPLETED       // Hoàn thành (Giải ngân cho Seller)
  REFUNDED        // Hoàn tiền cho Buyer
}

// ─── MODELS ────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  phone        String?
  role         Role     @default(BUYER)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items           Item[]
  sellerAuctions  Auction[]      @relation("SellerAuctions")
  wonAuctions     Auction[]      @relation("WinnerAuctions")
  bids            Bid[]
  orders          Order[]        @relation("BuyerOrders")
  sellerOrders    Order[]        @relation("SellerOrders")
  notifications   Notification[]
  reviews         Review[]       @relation("ReviewerReviews")
  receivedReviews Review[]       @relation("ReviewedReviews")
  watchlists      Watchlist[]    // Bổ sung liên kết Watchlist

  @@index([email])
  @@index([role])
  @@map("users")
}

model Item {
  id            String   @id @default(uuid())
  sellerId      String   @map("seller_id")
  title         String
  description   String?  @db.Text
  category      String?
  condition     String?
  images        String[]
  startingPrice Decimal  @map("starting_price") @db.Decimal(20, 2)
  reservePrice  Decimal? @map("reserve_price") @db.Decimal(20, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  seller   User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  auctions Auction[]

  @@index([sellerId])
  @@index([category])
  @@map("items")
}

model Auction {
  id            String   @id @default(uuid())
  itemId        String   @map("item_id")
  sellerId      String   @map("seller_id")
  startingPrice Decimal  @map("starting_price") @db.Decimal(20, 2)
  currentPrice  Decimal  @map("current_price") @db.Decimal(20, 2)
  minIncrement  Decimal  @default(1.00) @map("min_increment") @db.Decimal(20, 2)
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  status        AuctionStatus @default(PENDING)
  winnerId      String?  @map("winner_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seller        User        @relation("SellerAuctions", fields: [sellerId], references: [id])
  winner        User?       @relation("WinnerAuctions", fields: [winnerId], references: [id])
  bids          Bid[]
  orders        Order[]
  watchlistedBy Watchlist[] // Bổ sung liên kết Watchlist

  @@index([status, endTime])
  @@index([sellerId])
  @@map("auctions")
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String   @map("auction_id")
  bidderId  String   @map("bidder_id")
  amount    Decimal  @db.Decimal(20, 2)
  bidTime   DateTime @default(now()) @map("bid_time")
  isAutoBid Boolean  @default(false) @map("is_auto_bid")

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@index([auctionId, amount(sort: Desc)]) // Đổi từ bidTime sang amount để tìm Max Bid nhanh hơn
  @@index([bidderId])
  @@map("bids")
}

model Order {
  id              String   @id @default(uuid())
  auctionId       String   @map("auction_id") @unique
  buyerId         String   @map("buyer_id")
  sellerId        String   @map("seller_id")
  amount          Decimal  @db.Decimal(20, 2)
  platformFee     Decimal  @map("platform_fee") @db.Decimal(20, 2)
  shippingFee     Decimal  @default(0) @map("shipping_fee") @db.Decimal(20, 2)
  total           Decimal  @db.Decimal(20, 2)
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentMethod   String?  @map("payment_method")
  paymentRef      String?  @map("payment_ref")
  shippingAddress Json?    @map("shipping_address")
  trackingNumber  String?  @map("tracking_number")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  auction Auction @relation(fields: [auctionId], references: [id])
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller  User    @relation("SellerOrders", fields: [sellerId], references: [id])
  reviews Review[] // Bổ sung liên kết 1 Đơn hàng -> Nhiều Đánh giá (nếu cả 2 bên cùng đánh giá)

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@map("orders")
}

// Bảng Watchlist được bổ sung để phục vụ tính năng "Đang theo dõi"
model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  auctionId String   @map("auction_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId]) // Đảm bảo 1 user không thể theo dõi 1 phiên nhiều lần
  @@map("watchlists")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String?  @db.Text
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Review {
  id         String   @id @default(uuid())
  reviewerId String   @map("reviewer_id")
  reviewedId String   @map("reviewed_id")
  orderId    String   @map("order_id")
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  reviewer User  @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewed User  @relation("ReviewedReviews", fields: [reviewedId], references: [id])
  order    Order @relation(fields: [orderId], references: [id]) // Vá lỗi thiết lập liên kết với bảng Order

  @@unique([reviewerId, orderId])
  @@index([reviewedId])
  @@map("reviews")
}